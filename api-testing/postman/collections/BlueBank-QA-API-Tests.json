    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Login successful\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Access token exists\", function () {\r\n    pm.expect(response.access_token).to.be.a(\"string\").and.not.empty;\r\n});\r\n\r\nif (response.access_token) {\r\n    pm.collectionVariables.set(\"access_token\", response.access_token);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"john.doe@bluebank.test\", \"password\": \"BlueBank@123\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
