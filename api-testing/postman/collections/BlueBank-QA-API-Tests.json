    {
      "name": "Create Transfer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Insufficient balance transfer is rejected\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([400, 422]);\r\n});\r\n\r\npm.test(\"Error response is returned\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response).to.have.property(\"detail\");\r\n});"
            ]
          }
        }
      ],
